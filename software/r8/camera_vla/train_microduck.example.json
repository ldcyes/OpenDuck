{
  "dataset": {
    "repo_id": "local/microduck-r8",
    "root": "/data/microduck-r8-dataset"
  },
  "policy": {
    "type": "smolvla",
    "device": "cuda",
    "pretrained_path": "lerobot/smolvla_base",
    "input_features": {
      "observation.state": {
        "type": "STATE",
        "shape": [
          21
        ]
      },
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [
          3,
          480,
          640
        ]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [
          11
        ]
      }
    },
    "push_to_hub": false,
    "max_state_dim": 32,
    "max_action_dim": 32
  },
  "output_dir": "/data/training/microduck-r8",
  "batch_size": 16,
  "steps": 1000,
  "save_freq": 500,
  "log_freq": 50,
  "wandb": {
    "enable": false
  }
}
