# Copy locally to /etc/microduck-r8/interaction.env; set permissions0600.
# Generate a fresh token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MICRODUCK_LOCAL_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
MICRODUCK_LOCAL_URL=http://127.0.0.1:8766
MICRODUCK_PLAYBACK_DEVICE=plughw:CARD=MicroduckAudio,DEV=0
MICRODUCK_CAPTURE_DEVICE=plughw:CARD=MicroduckAudio,DEV=0
MICRODUCK_AUDIO_GAIN=0.20
MICRODUCK_PROVIDER_TIMEOUT=15
# Optional local or LAN chat-completions server; exact endpoint and model ID required.
MICRODUCK_LLM_PROTOCOL=chat-completions
MICRODUCK_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
MICRODUCK_LLM_MODEL=REPLACE_WITH_SERVED_MODEL_ID
MICRODUCK_LLM_MAX_TOKENS=256
MICRODUCK_LLM_API_KEY=
# Host speech gateway: keep127.0.0.1 through SSH -L8768 forwarding, or configure HTTPS proxy URLs.
MICRODUCK_ASR_URL=http://127.0.0.1:8768/v1/asr
MICRODUCK_TTS_URL=http://127.0.0.1:8768/v1/tts
MICRODUCK_ASR_API_KEY=REPLACE_WITH_SPEECH_GATEWAY_TOKEN
MICRODUCK_TTS_API_KEY=REPLACE_WITH_SPEECH_GATEWAY_TOKEN
